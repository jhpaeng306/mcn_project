# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# Simulation data (regenerate with the code; small tables in results/ are tracked)
*.npz
*.npy
*.h5
*.hdf5
*.pkl
*.mp4
*.gif
output/
archive/legacy_code/simulations/output/
experiments/

# Notebook exports
*.nbconvert.ipynb
*.html

# LaTeX build files (sources and the tracked report PDFs stay)
*.aux
*.log
*.fls
*.fdb_latexmk
*.out
*.synctex.gz
*.toc
*.nav
*.snm
*.bbl
*.blg
*.bcf
*.run.xml
*.tmp
theory/*/main.pdf

# OS, editors, local agent settings
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.claude/settings.local.json

# Slides: track the deck, its build sources, and its media (overrides build/, *.html, *.mp4 above)
!slides/build/
!slides/**/*.html
!slides/media/*.mp4
